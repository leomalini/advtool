# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → Data API → Project URL / API Keys
# Ambas são expostas ao browser (NEXT_PUBLIC_): use a chave publishable/anon,
# NUNCA a service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ── BuscaProcessos ────────────────────────────────────────────────────────────
# Consulta de processos por CNJ e monitoramento de movimentações.
# Chave em https://buscaprocessos.app.br/dashboard — server-side apenas.
# Sem ela, as rotas /api/buscaprocessos/* respondem 503.
BUSCA_PROCESSOS_API_KEY=

# Segredo compartilhado para validar a assinatura HMAC dos webhooks.
# ATENÇÃO: hoje, se ficar vazio, /api/webhooks/buscaprocessos aceita qualquer
# payload sem validar assinatura — conveniente em dev, inseguro em produção.
# Preencher antes de expor o endpoint (endurecimento previsto na Fase 6 do
# docs/ROADMAP-MODULOS.md).
#
# Configurações → Webhooks mostra se ele está preenchido, lista tudo que chegou
# no endpoint e dispara eventos de teste — em simulação por padrão, ou assinados
# de verdade contra a URL abaixo.
#
# A chave da conta são 64 caracteres hexadecimais, ou seja, 32 bytes escritos em
# hexa. Copie exatamente como aparece lá: o endpoint confere as duas leituras
# possíveis (a string de 64 caracteres e os 32 bytes que ela representa), porque
# nada no cabeçalho diz qual delas a origem usou.
BUSCA_PROCESSOS_WEBHOOK_SECRET=

# Token Bearer do webhook, enviado em `Authorization: Bearer …`. É a OUTRA forma
# de autenticação oferecida pela BuscaProcessos, e qual delas chega depende de
# como o webhook foi configurado lá. Preencher os dois não custa nada e evita um
# 401 em entrega legítima; o prefixo `bp_wh_` pode entrar ou não.
BUSCA_PROCESSOS_WEBHOOK_TOKEN=

# ── Endereço público da aplicação ─────────────────────────────────────────────
# Só a base, sem caminho. É a partir dela que montamos a URL do NOSSO endpoint
# de recebimento (/api/webhooks/buscaprocessos) e a registramos na
# BuscaProcessos ao ativar o monitoramento de intimações por OAB
# (Configurações → Publicações).
#
# Com ela a publicação chega sozinha; sem ela o monitoramento funciona igual,
# mas é preciso usar "Buscar publicações". Precisa ser alcançável pela
# internet: localhost é recusado no código, porque registrar um endereço
# inacessível daria a aparência de entrega automática com toda entrega falhando.
#
# Exemplo: https://app.seuescritorio.com.br
APP_PUBLIC_URL=

# ── Supabase — service role ───────────────────────────────────────────────────
# ⚠️ IGNORA TODA A RLS. Abre o banco inteiro, sem perfil e sem policy.
# Project Settings → API → service_role (secret).
#
# Regras:
#   · NUNCA com prefixo NEXT_PUBLIC_ — iria para o bundle do browser.
#   · Só usada em Route Handlers, via src/lib/supabase/admin.ts.
#   · Este arquivo é versionado: deixe o valor VAZIO aqui e preencha só no .env
#     local (ignorado pelo git) e nas variáveis do host de produção.
#
# Sem ela: /api/admin/users responde 503 (convidar e trocar perfil ficam
# indisponíveis) e o webhook do BuscaProcessos descarta as movimentações.
SUPABASE_SERVICE_ROLE_KEY=
